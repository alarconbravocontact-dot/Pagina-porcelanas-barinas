# --- Base de datos (PostgreSQL 14+) ---
DATABASE_URL=postgresql://porcelana:CAMBIAR@localhost:5432/porcelanas?schema=public

# --- Servidor ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Origen público del frontend (para CORS de Socket.IO y enlaces). En producción, el mismo dominio.
PUBLIC_ORIGIN=http://localhost:5173
# true en producción detrás de HTTPS (cookies Secure)
COOKIE_SECURE=false
# true si el servidor está detrás de un proxy inverso (Nginx, Caddy, etc.)
TRUST_PROXY=false
SESSION_TTL_HOURS=168
# Duración de la sesión de clientes sin contraseña (su identificación en el dispositivo)
CUSTOMER_SESSION_TTL_DAYS=180

# --- Almacenamiento de archivos ---
# Directorio raíz. Se crean /public (fotos de productos) y /private (comprobantes, nunca servido estáticamente).
STORAGE_DIR=./storage

# --- Zona horaria comercial de la sede ---
BUSINESS_TIMEZONE=America/Caracas

# --- Tareas programadas (vencimiento de reservas, tasa BCV) ---
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=60

# --- Semilla inicial (solo se usan al ejecutar npm run db:seed) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
