{
  "name": "@porcelanas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "db:seed:demo": "tsx --env-file-if-exists=../../.env prisma/seed.ts --demo",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@node-rs/argon2": "2.0.2",
    "@porcelanas/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "fastify-plugin": "5.1.0",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "prisma": "6.19.3",
    "socket.io-client": "4.8.1",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "vitest": "4.1.12"
  }
}
